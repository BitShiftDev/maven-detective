# Shell-Skripte und Fixture-Dateien auch unter Windows (core.autocrlf) mit LF auschecken –
# bash bricht sonst an \r ab (CI-Matrix mit windows-latest)
* text=auto eol=lf
# gradlew.bat liegt mit CRLF im Repository und bleibt unverändert
*.bat -text
# Test-POMs mit Windows-Zeilenenden: PomEditorInvariantTest prüft, dass CRLF erhalten bleibt
core/src/test/resources/poms/*crlf*.xml -text
# Testlogs aus Windows-Builds: der Parser muss CRLF selbst verkraften
core/src/test/resources/logs*/*crlf*.log -text
