<idea-plugin>
    <!-- id, name, version und since-build setzt das IntelliJ Platform Gradle Plugin (build.gradle.kts) -->
    <id>io.github.bitshiftdev.mavendetective</id>
    <name>Maven Detective</name>
    <vendor url="https://github.com/BitShiftDev">BitShiftDev</vendor>

    <!-- Englisch Pflicht: Plugin Verifier und Marketplace verlangen eine Beschreibung, die mit
         mindestens 40 lateinischen Zeichen beginnt (Umlaute zählen nicht) -->
    <description><![CDATA[
    <p><b>Maven Detective explains why your Maven build failed – and fixes it in one click.</b></p>
    <p>Instead of scrolling through 500 lines of stack traces and download noise, you get a diagnosis card:
       the cause in one sentence, the log lines and files that prove it, a confidence level and a quick fix.
       Every green build becomes a reference, so you also see <i>what changed</i> since the build last worked.</p>

    <h3>Build Doctor</h3>
    <ul>
      <li><b>Cause, not symptoms:</b> recognises the Maven classics – cached failed downloads (<code>.lastUpdated</code>),
          401/403 without a matching <code>&lt;server&gt;</code>, blocked http repositories, corrupt JARs, the wrong JDK,
          invalid POMs, reactor problems, missing plugins, enforcer rules, out of memory, EAR/WAR/EJB packaging –
          and verifies each suspicion against your local repository, <code>settings.xml</code>, JDK and POMs.</li>
      <li><b>One-click fixes:</b> rebuild with <code>-U</code>/<code>-am</code>, switch the runner JDK, set a plugin version,
          delete broken files, add a JVM option. The plugin rebuilds and tells you <i>Fixed ✓</i> or shows the next diagnosis.</li>
      <li><b>What changed?</b> JDK, Maven, profiles, parent, plugins and dependencies since the last green build.</li>
      <li><b>Where did that class come from?</b> For <code>NoSuchMethodError</code>, <code>NoClassDefFoundError</code> and
          <code>package … does not exist</code>: which JAR the JVM loads, whether it has the method, which version lost and why.</li>
      <li><b>IDE vs. command line:</b> "works in the terminal, fails in IntelliJ" – Maven, JDK, <code>settings.xml</code>,
          profiles and <code>.mvn/</code> configuration side by side.</li>
      <li><b>Preflight:</b> a traffic light for your setup <i>before</i> the build – including repository access behind
          corporate proxies, on request.</li>
      <li><b>Log navigator:</b> jump to the first real error and the failed module; download noise folded away in the console.</li>
    </ul>

    <h3>Dependency X-ray</h3>
    <ul>
      <li><b>Why This Version?</b> Alt+Enter on any dependency shows the decision chain – declaration,
          dependencyManagement, imported BOM, property, nearest-wins path – each step jumps to its POM line.</li>
      <li><b>Conflict matrix:</b> artifact × module for the whole reactor; pin a version in the common parent with one click.</li>
      <li><b>Duplicate classes:</b> the same class in several JARs (e.g. <code>commons-logging</code> next to
          <code>jcl-over-slf4j</code>), which copy wins, and the exclusion that removes the redundant JAR.</li>
      <li><b>Exclusion hygiene:</b> greys out exclusions that no longer exclude anything.</li>
      <li><b>Unused and undeclared dependencies:</b> based on the classes your code actually names – declare, remove or
          change scope with one click; live inspection on imports.</li>
      <li><b>Upgrade simulator:</b> "what happens if I raise X to Y?" – see what goes up, down, appears or disappears in
          every module's tree <i>before</i> the POM changes, then apply exactly that change.</li>
      <li><b>Answers in your pom.xml:</b> <code>2.18.2 · jackson-bom</code> behind managed dependencies,
          <code>3 modules · 2 versions</code> above conflicting ones, gutter icons for lost versions and duplicate classes.</li>
    </ul>

    <h3>Safe by design</h3>
    <ul>
      <li>Every quick fix that edits a <code>pom.xml</code> shows a diff first and is a single undo step.</li>
      <li>Checks only read local files – the network is used only when you ask for it.</li>
      <li>English and German user interface and diagnoses.</li>
      <li>The same diagnosis on the command line and in CI via the
          <a href="https://github.com/BitShiftDev/maven-detective#maven-extension">Maven extension</a>.</li>
    </ul>

    <p>Maven Detective complements Maven Helper and the Dependency Analyzer: they show you the facts,
       Maven Detective shows you the cause and the fix.
       <a href="https://github.com/BitShiftDev/maven-detective">Source, docs and issues on GitHub</a>.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.idea.maven</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>com.intellij.java</depends>

    <!-- Texte von Aktionen (action.<id>.text/.description) und Oberfläche -->
    <resource-bundle>messages.MavenDetectiveBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Maven Detective"
                    anchor="bottom"
                    icon="/icons/mavenDetective.svg"
                    factoryClass="io.github.bitshiftdev.mavendetective.idea.BuildDoctorToolWindowFactory"/>
        <notificationGroup id="Maven Detective" displayType="BALLOON"/>
        <!-- U6: New-UI-Icon des Tool-Windows (icons/expui/, 16 × 16 und @20x20) statt des 13 × 13 der alten Oberfläche -->
        <iconMapper mappingFile="MavenDetectiveIconMappings.json"/>
        <!-- U6: Einstellungen unter Tools | Maven Detective (Zustand: DetectiveSettings, mavenDetective.xml) -->
        <applicationConfigurable parentId="tools"
                                 id="io.github.bitshiftdev.mavendetective.settings"
                                 instance="io.github.bitshiftdev.mavendetective.idea.DetectiveConfigurable"
                                 bundle="messages.MavenDetectiveBundle"
                                 key="settings.title"/>
        <!-- U3: „[INFO] BUILD FAILURE“ in Konsole und Build-Fenster wird zum Link auf die Diagnose -->
        <consoleFilterProvider implementation="io.github.bitshiftdev.mavendetective.idea.BuildFailureConsoleFilter$Provider"/>
        <!-- Log-Navigator: Download-Zeilen von Maven in Konsole und Build-Fenster einklappen (Einstellung) -->
        <console.folding implementation="io.github.bitshiftdev.mavendetective.idea.DownloadConsoleFolding"/>
        <!-- Modul A4: Beschreibung in inspectionDescriptions/MavenDetectiveStaleExclusion.html -->
        <localInspection language="XML"
                         shortName="MavenDetectiveStaleExclusion"
                         bundle="messages.MavenDetectiveBundle"
                         key="inspection.stale.exclusion.name"
                         groupName="Maven Detective"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.github.bitshiftdev.mavendetective.idea.StaleExclusionInspection"/>
        <!-- Modul A5: Beschreibung in inspectionDescriptions/MavenDetectiveUndeclaredDependency.html -->
        <localInspection language="JAVA"
                         shortName="MavenDetectiveUndeclaredDependency"
                         bundle="messages.MavenDetectiveBundle"
                         key="inspection.undeclared.name"
                         groupName="Maven Detective"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="io.github.bitshiftdev.mavendetective.idea.UndeclaredDependencyInspection"/>

        <!-- U4: Antworten im Editor der pom.xml (Grundlage: PomInsights, gespeicherter Stand + letzter Import) -->
        <codeInsight.declarativeInlayProvider language="XML"
                                              implementationClass="io.github.bitshiftdev.mavendetective.idea.ManagedVersionInlayProvider"
                                              isEnabledByDefault="true"
                                              group="OTHER_GROUP"
                                              providerId="maven.detective.managed.version"
                                              bundle="messages.MavenDetectiveBundle"
                                              nameKey="inlay.managed.name"
                                              descriptionKey="inlay.managed.description"/>
        <codeInsight.inlayActionHandler handlerId="maven.detective.open.location"
                                        implementationClass="io.github.bitshiftdev.mavendetective.idea.ManagedVersionInlayProvider$OpenLocation"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="io.github.bitshiftdev.mavendetective.idea.ConflictCodeVisionProvider"/>
        <config.codeVisionGroupSettingProvider implementation="io.github.bitshiftdev.mavendetective.idea.ConflictCodeVisionProvider$Settings"/>
        <codeInsight.lineMarkerProvider language="XML"
                                        implementationClass="io.github.bitshiftdev.mavendetective.idea.PomFindingsLineMarkerProvider"/>
        <editorNotificationProvider implementation="io.github.bitshiftdev.mavendetective.idea.LastBuildNotificationProvider"/>
        <!-- U5: Ergebnis des Upgrade-Simulators als Editor-Tab (Diff der POMs + Baum-Unterschied) -->
        <fileEditorProvider implementation="io.github.bitshiftdev.mavendetective.idea.UpgradeResultEditor$Provider"/>
        <intentionAction>
            <language>XML</language>
            <className>io.github.bitshiftdev.mavendetective.idea.WhyThisVersionIntention</className>
            <bundleName>messages.MavenDetectiveBundle</bundleName>
            <categoryKey>intention.category</categoryKey>
        </intentionAction>
        <intentionAction>
            <language>XML</language>
            <className>io.github.bitshiftdev.mavendetective.idea.SimulateUpgradeIntention</className>
            <bundleName>messages.MavenDetectiveBundle</bundleName>
            <categoryKey>intention.category</categoryKey>
        </intentionAction>
    </extensions>

    <actions>
        <!-- Texte im Bundle messages/MavenDetectiveBundle.properties -->
        <!-- Editor: Popup am Cursor bzw. Upgrade-Simulator; Maven-Tool-Window und External Libraries: Seite im Tool-Window -->
        <action id="MavenDetective.WhyThisVersion"
                class="io.github.bitshiftdev.mavendetective.idea.WhyThisVersionAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="Maven.DependencyMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="MavenDetective.SimulateUpgrade"
                class="io.github.bitshiftdev.mavendetective.idea.SimulateUpgradeAction">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="MavenDetective.WhyThisVersion"/>
            <add-to-group group-id="Maven.DependencyMenu" anchor="after" relative-to-action="MavenDetective.WhyThisVersion"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="MavenDetective.WhyThisVersion"/>
        </action>

        <!-- Toolbar-Aktionen des Tool-Windows; wirken auf die Seite im Kontext (DetectivePanel.KEY) -->
        <action id="MavenDetective.Refresh"
                class="io.github.bitshiftdev.mavendetective.idea.ui.DetectiveActions$Refresh"
                icon="AllIcons.Actions.Refresh"/>
        <action id="MavenDetective.Stop"
                class="io.github.bitshiftdev.mavendetective.idea.ui.DetectiveActions$Stop"
                icon="AllIcons.Actions.Suspend"/>
        <action id="MavenDetective.CopyMarkdown"
                class="io.github.bitshiftdev.mavendetective.idea.ui.DetectiveActions$CopyMarkdown"
                icon="AllIcons.Actions.Copy"/>
        <action id="MavenDetective.AnalyzeClipboard"
                class="io.github.bitshiftdev.mavendetective.idea.BuildDoctorActions$AnalyzeClipboard"
                icon="AllIcons.Actions.MenuPaste"/>
        <action id="MavenDetective.CompareSetup"
                class="io.github.bitshiftdev.mavendetective.idea.BuildDoctorActions$CompareSetup"
                icon="AllIcons.Actions.Diff"/>
        <!-- Preflight vor dem Build; auch in der Toolbar des Maven-Tool-Windows -->
        <action id="MavenDetective.Preflight"
                class="io.github.bitshiftdev.mavendetective.idea.BuildDoctorActions$Preflight"
                icon="AllIcons.Actions.Checked">
            <add-to-group group-id="Maven.NavigatorActionsToolbar" anchor="last"/>
        </action>
        <!-- Log-Navigator: Log des gezeigten Laufs mit Gliederung, beim ersten Fehler -->
        <action id="MavenDetective.ShowLog"
                class="io.github.bitshiftdev.mavendetective.idea.BuildDoctorActions$ShowLog"
                icon="AllIcons.Debugger.Console"/>
        <action id="MavenDetective.ReportMisdiagnosis"
                class="io.github.bitshiftdev.mavendetective.idea.BuildDoctorActions$ReportMisdiagnosis"
                icon="AllIcons.Ide.Dislike"/>
        <!-- U5: Diff-Vorschau vor jeder POM-Änderung (an per Default); steht im Filter-Menü der Dependency-Seiten -->
        <action id="MavenDetective.PreviewPomFixes"
                class="io.github.bitshiftdev.mavendetective.idea.PreviewPomFixesAction"/>

        <!-- Kontextmenü auf Zeilen in Tabellen und Listen des Tool-Windows -->
        <group id="MavenDetective.RowPopup">
            <reference ref="EditSource"/>
            <reference ref="$Copy"/>
        </group>
    </actions>

    <applicationListeners>
        <!-- Sprache des Kerns (Diagnose-Texte) = Einstellung „Sprache“ des Plugins -->
        <listener class="io.github.bitshiftdev.mavendetective.idea.CoreLanguage"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="io.github.bitshiftdev.mavendetective.idea.MavenRunListener"
                  topic="com.intellij.execution.ExecutionListener"/>
        <!-- U6: Erste Schritte – „Got it“-Hinweis beim ersten Öffnen einer pom.xml -->
        <listener class="io.github.bitshiftdev.mavendetective.idea.FirstSteps$PomOpened"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
